    {
      "op": "expectEquation",
      "selector": "#total",
      "total": "#total",
      "locked": "#lockedView",
      "available": "#available"
    },
    {
      "op": "click",
      "selector": "#pay"
    },
    {
      "op": "expectText",
      "selector": "#total",
      "equals": "32"
    },
    {
      "op": "expectState",
      "path": "locked",
      "equals": 7
    },
    {
      "op": "expectState",
      "path": "available",
      "equals": 25
    },
    {
      "op": "expectText",
