  "applies_from": "P2-A3",
  "levels": {
    "L0": {
      "when": "every commit",
      "commands": [
        "ruff check src tests tools",
        "git diff --check",
        "git status --short --untracked-files=no"
      ]
    },
    "L1": {
      "when": "every implementation slice",
      "content": "the slice's impact set (own tests + directly affected tests + the layer below)",
      "impact_sets": "see impact_sets"
    },
    "L2": {
      "when": "every sub-phase CLOSED (Ax / Bx / Cx)",
      "content": "the named stage gate below (sub-phase stack + adjacent contract tests + key regressions)"
    },
    "L3": {
      "when": "major phase CLOSED (P2-A / P2-B / ...), production authority cutover, pre-release",
      "commands": [
        "python -m pytest tests"
      ]
    }
  },
