{
  "schema_version": "search-2-fact-checks-v1",
  "frozen_at": "2026-10-29",
  "purpose": "Search-2 small live probe: for each case decide in order whether the delivered top-1 is about the question, whether it can be read, and whether the read page actually contains the fact the question needs.",
  "rules": {
    "expect_all": "every token must appear (case-insensitive) in the read text",
    "expect_any_group": "at least one token from the group must appear"
